# Linux: pre-create server/cache/backups directories owned by uid/gid 10001.
THELXINOE_STATE_ROOT=./.local/docker
THELXINOE_DATA_ROOT=./.local/media
THELXINOE_BACKUP_ROOT=./.local/backups
THELXINOE_LISTEN=127.0.0.1
# For an administrator-managed HTTPS reverse proxy:
# THELXINOE_PUBLIC_URL=https://media.example.com
# THELXINOE_TRUSTED_PROXIES=172.30.0.0/24
# LAN discovery advertises this origin, or PUBLIC_URL when omitted. For direct
# LAN access also set THELXINOE_LISTEN to the host's LAN address or 0.0.0.0.
# THELXINOE_DISCOVERY_URL=http://192.168.1.20:8484
# THELXINOE_DISCOVERY=false
# Signed product release channel; leave empty until a publisher is configured.
# THELXINOE_RELEASE_URL=https://releases.example.com/latest.json
# Optional separate browser-client origins. The normal web/PWA needs no CORS.
# THELXINOE_CORS_ORIGINS=https://client.example.com
