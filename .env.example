# After changing this file, run `docker compose up -d`; the controller adopts the
# recreated containers. `docker compose pull && docker compose up -d` updates.
# Images are published for Linux amd64 (x86-64) hosts only.
# Non-root numeric IDs; use your host media account's `id -u` and `id -g`.
THELXINOE_UID=10001
THELXINOE_GID=10001
# Relative paths start from the directory holding compose.yaml; absolute paths
# such as /volume1/thelxinoe are clearer on a NAS.
# Linux: pre-create server/cache/media/backups directories with access for these IDs.
THELXINOE_STATE_ROOT=./.local/docker
THELXINOE_MEDIA_ROOT=./.local/media
# All media services must bind this same directory at /media. See docs/OPERATIONS.md.
THELXINOE_BACKUP_ROOT=./.local/backups
# 127.0.0.1 accepts connections from this host only (for example a reverse proxy
# on it). For direct LAN access use the host's LAN address or 0.0.0.0.
THELXINOE_LISTEN=127.0.0.1
# For an administrator-managed HTTPS reverse proxy:
# THELXINOE_PUBLIC_URL=https://media.example.com
# THELXINOE_TRUSTED_PROXIES=172.30.0.0/24
# LAN discovery advertises this origin, or PUBLIC_URL when omitted.
# THELXINOE_DISCOVERY_URL=http://192.168.1.20:8484
# THELXINOE_DISCOVERY=false
# Discovery uses UDP 7359, the only port clients search. If another Jellyfin server
# on this host already publishes it, remove the 7359 line from compose.yaml (or use
# `ports: !override` in compose.override.yaml), set THELXINOE_DISCOVERY=false and add
# the server to clients by address.
# Optional separate browser-client origins. The normal web/PWA needs no CORS.
# THELXINOE_CORS_ORIGINS=https://client.example.com
# IPv6 lets public YouTube videos switch address family when one is blocked. It
# needs Docker Engine 27 or Docker Desktop 4.42 and host IPv6 internet access.
# THELXINOE_IPV6=true
# Automatic updates install during the maintenance window (Settings → Server). Its
# hours follow the "Server default timezone" setting, UTC until changed, not the
# host's TZ.
# Leave THELXINOE_SERVER_IMAGE and THELXINOE_CONTROLLER_IMAGE unset. Never pin them
# to a version or digest: in-app updates and `docker compose up -d` rely on the
# `latest` tags, and a pinned image makes Compose bring the pinned release back.
