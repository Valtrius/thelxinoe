# syntax=docker/dockerfile:1
FROM node:24-bookworm-slim AS node
FROM rust:1.98-bookworm
WORKDIR /src
ENV CARGO_INCREMENTAL=0 CARGO_PROFILE_DEV_DEBUG=0 CARGO_PROFILE_TEST_DEBUG=0
COPY --from=node /usr/local/bin/node /usr/local/bin/node
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg python3 && rm -rf /var/lib/apt/lists/* && rustup component add clippy rustfmt
COPY Cargo.toml Cargo.lock ./
COPY crates crates
COPY apps apps
COPY package.json ./
COPY scripts scripts
COPY tests tests
RUN --mount=type=cache,target=/usr/local/cargo/registry --mount=type=cache,target=/src/target,id=thelxinoe-verification-target,sharing=locked node scripts/ci.mjs server
