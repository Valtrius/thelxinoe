# syntax=docker/dockerfile:1
FROM rust:1.98-bookworm
WORKDIR /src
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg && rm -rf /var/lib/apt/lists/* && rustup component add clippy rustfmt
COPY Cargo.toml Cargo.lock ./
COPY crates crates
COPY apps apps
RUN --mount=type=cache,target=/usr/local/cargo/registry --mount=type=cache,target=/src/target cargo fmt --all --check && cargo clippy --locked --all-targets -- -D warnings && cargo test --locked
