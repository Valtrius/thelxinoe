# syntax=docker/dockerfile:1
ARG BASE_IMAGE=mcr.microsoft.com/playwright:v1.65.0-noble@sha256:6e3fb709361521eb27161606e6da6d2674e5e89fa16516cb37d6fdd91372273d
FROM ${BASE_IMAGE}
ARG PLAYWRIGHT_VERSION=1.65.0
WORKDIR /opt/playwright
RUN npm install --no-save --ignore-scripts @playwright/test@${PLAYWRIGHT_VERSION}
USER pwuser
CMD ["node", "node_modules/playwright/cli.js", "run-server", "--port", "3000", "--host", "0.0.0.0", "--unsafe"]
