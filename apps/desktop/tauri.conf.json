{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Thelxinoe",
  "version": "0.1.0",
  "identifier": "app.thelxinoe.desktop",
  "build": {
    "beforeDevCommand": "pnpm --dir .. run dev:web",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --dir .. run build:web",
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Thelxinoe",
        "label": "main",
        "width": 1360,
        "height": 900,
        "minWidth": 760,
        "minHeight": 560,
        "decorations": false,
        "visible": false
      },
      {
        "title": "Thelxinoe",
        "label": "splashscreen",
        "url": "splashscreen.html",
        "backgroundColor": "#05070b",
        "width": 420,
        "height": 240,
        "resizable": false,
        "decorations": false,
        "center": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http: https: ws: wss:; img-src 'self' data: blob: http: https:; media-src 'self' blob: http: https:; style-src 'self' 'unsafe-inline'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": []
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"]
  }
}
