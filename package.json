{
  "name": "thelxinoe",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "npm run dev --workspace frontend --",
    "dev:desktop": "node scripts/desktop.mjs --dev",
    "dev:fresh": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/dev-fresh.ps1",
    "dev:online": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/dev-online.ps1",
    "build:web": "npm run version:check && npm run build --workspace frontend",
    "build:desktop": "node scripts/desktop.mjs",
    "build:containers": "docker compose build",
    "check": "npm run format:check && npm run lint && npm run check:web && npm run check:rust",
    "check:web": "npm run check --workspace frontend",
    "check:rust": "cargo fmt --all --check && cargo clippy --all-targets -- -D warnings",
    "test": "npm run test:web && npm run test:rust && npm run test:python",
    "test:web": "npm run test --workspace frontend",
    "test:rust": "cargo test",
    "test:python": "node scripts/python-tests.mjs",
    "test:e2e": "playwright test",
    "test:ui:player": "playwright test --config playwright.player.config.ts",
    "test:ui:layout": "playwright test --config playwright.layout.config.ts",
    "lint": "eslint frontend scripts tests --max-warnings=0",
    "format": "prettier --write frontend scripts tests package.json .github README.md docs",
    "format:check": "prettier --check frontend scripts tests package.json .github README.md docs",
    "version:sync": "node scripts/version.mjs --write",
    "version:check": "node scripts/version.mjs",
    "validate": "npm run check && npm test && npm run build:web",
    "validate:web": "npm run format:check && npm run lint && npm run check:web && npm run test:web && npm run build:web",
    "ci": "node scripts/ci.mjs",
    "ci:server": "node scripts/ci.mjs server",
    "ci:web": "node scripts/ci.mjs web",
    "ci:containers": "node scripts/ci.mjs containers",
    "ci:desktop": "node scripts/ci.mjs desktop"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "@tauri-apps/cli": "^2.11.4",
    "eslint": "^10.8.0",
    "eslint-plugin-svelte": "^3.22.0",
    "globals": "^17.8.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "typescript-eslint": "^8.65.0"
  }
}
